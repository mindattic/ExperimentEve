{
  "name": "experiment-eve",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:three": "vite --config three/vite.config.ts",
    "build:three": "tsc -p three/tsconfig.json && vite build --config three/vite.config.ts",
    "preview:three": "vite preview --config three/vite.config.ts",
    "dev:babylon": "vite --config babylon/vite.config.ts",
    "build:babylon": "tsc -p babylon/tsconfig.json && vite build --config babylon/vite.config.ts",
    "preview:babylon": "vite preview --config babylon/vite.config.ts",
    "universe": "node scripts/universe.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^7.54.0",
    "@babylonjs/loaders": "^7.54.0",
    "@babylonjs/materials": "^7.54.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
